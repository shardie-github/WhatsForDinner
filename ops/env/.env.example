# Environment Configuration Template
# Copy this to .env.local in each app directory

# ============================================
# SUPABASE (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# CRASH REPORTING
# ============================================
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# ============================================
# PAYMENTS
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# MONETIZATION (RevenueCat)
# ============================================
REVENUECAT_API_KEY=your-revenuecat-api-key
REVENUECAT_PROXY_URL=https://your-proxy-url.com/proxy
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=your-public-key

# ============================================
# PUSH NOTIFICATIONS
# ============================================
# Firebase Cloud Messaging (Android)
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# Apple Push Notification Service (iOS)
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=app.whatsfordinner
APNS_KEY_PATH=./ops/certs/AuthKey_XXXXXXXXXX.p8

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=https://api.whatsfordinner.app

# ============================================
# DEEP LINKS & UNIVERSAL LINKS
# ============================================
NEXT_PUBLIC_APP_SCHEME=whatsfordinner
NEXT_PUBLIC_UNIVERSAL_LINK_DOMAIN=whatsfordinner.app

# ============================================
# AI/ML SERVICES
# ============================================
OPENAI_API_KEY=sk-...
NEXT_PUBLIC_OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# EMAIL (Resend/SendGrid)
# ============================================
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@whatsfordinner.app

# ============================================
# STORE CONFIGURATION
# ============================================
# Android
ANDROID_KEYSTORE_PATH=./ops/certs/android-release.keystore
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=whatsfordinner
ANDROID_KEY_PASSWORD=your-key-password

# iOS
IOS_PROVISIONING_PROFILE_PATH=./ops/certs/AppStore.mobileprovision
IOS_CERTIFICATE_PATH=./ops/certs/distribution.p12
IOS_CERTIFICATE_PASSWORD=your-cert-password
APP_STORE_CONNECT_API_KEY_PATH=./ops/certs/AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_ISSUER_ID=your-issuer-id
APP_STORE_CONNECT_KEY_ID=your-key-id

# ============================================
# ENVIRONMENT-SPECIFIC
# ============================================
# Development
DEV_API_URL=http://localhost:3000

# Staging
STAGING_API_URL=https://staging.whatsfordinner.app

# Production
PROD_API_URL=https://api.whatsfordinner.app

# ============================================
# MONETIZATION MODE
# ============================================
# Options: none | billing_native | reader_external
MONETIZATION_MODE=billing_native
