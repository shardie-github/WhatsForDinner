graph TB
    %% Reinforcing Loops (R)
    
    subgraph R1["R1: Feature Throughput"]
        FT[Feature Throughput] -->|More Features| CS[Customer Satisfaction]
        CS -->|More Revenue| RT[Resource Time]
        RT -->|More Developers| FT
    end
    
    subgraph R2["R2: Incident Response"]
        IR[Incident Response] -->|Faster Fixes| SR[System Reliability]
        SR -->|Less Firefighting| ET[Engineering Time]
        ET -->|More Time for Features| IR
    end
    
    subgraph R3["R3: Telemetry-Driven Fixes"]
        TF[Telemetry & Monitoring] -->|Better Visibility| PQ[Problem Quality]
        PQ -->|Faster Diagnosis| FR[Fix Rate]
        FR -->|More Data| TF
    end
    
    %% Balancing Loops (B)
    
    subgraph B1["B1: Tech Debt"]
        TD[Tech Debt] -->|Slows Development| FT
        FT -->|New Features| TD
        TD -.->|Refactoring| TD
    end
    
    subgraph B2["B2: Quality vs Speed"]
        QV[Quality Velocity] -->|Higher Quality| CS
        QV -.->|Takes Time| SV[Speed Velocity]
        SV -->|Faster Delivery| CS
    end
    
    subgraph B3["B3: Team Capacity"]
        TC[Team Capacity] -->|Limited| FT
        FT -->|More Work| TC
        TC -.->|Hiring| TC
    end
    
    %% Connections
    SR --> CS
    FR --> SR
    TD --> IR
    QV --> TD
    
    style R1 fill:#dbeafe
    style R2 fill:#dbeafe
    style R3 fill:#dbeafe
    style B1 fill:#fef3c7
    style B2 fill:#fef3c7
    style B3 fill:#fef3c7
