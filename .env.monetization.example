# Monetization Configuration
# Copy these to your .env file to enable monetization channels

# Affiliate Marketing
AFFILIATE_ENABLED=true
AFFILIATE_COMMISSION_RATE=10
AFFILIATE_COOKIE_DURATION=30
AFFILIATE_MIN_PAYOUT=50

# API Monetization
API_MONETIZATION_ENABLED=true
API_FREE_TIER_LIMIT=1000
API_RATE_LIMIT_ENABLED=true

# Data Insights
DATA_INSIGHTS_ENABLED=true

# Marketplace
MARKETPLACE_ENABLED=true
MARKETPLACE_COMMISSION_RATE=10

# Automated Upsells
AUTOMATED_UPSELLS_ENABLED=true

# Stripe Configuration (for payouts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET_MONETIZATION=whsec_...

# Cron Jobs (for automated payouts)
CRON_SECRET=your_cron_secret_here

# Revenue Dashboard
REVENUE_DASHBOARD_ENABLED=true
