# Supabase Configuration (REQUIRED)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=${SUPABASE_DB_URL}

# Timezone (REQUIRED - defaults to America/Toronto)
TZ=America/Toronto

# Generic Source A (optional - for ads/events)
GENERIC_SOURCE_A_TOKEN=your-source-a-token

# Generic Source B (optional - for ads/events)
GENERIC_SOURCE_B_TOKEN=your-source-b-token

# Slack Webhook (optional - for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Feature Flags (optional)
FEATURE_FLAGS_PATH=./featureflags/flags.json

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info

# Stripe (optional - for revenue tracking)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Meta Ads API (optional - legacy)
META_TOKEN=your-meta-access-token
META_ACCOUNT_ID=your-meta-ad-account-id
META_AD_ACCOUNT_ID=${META_ACCOUNT_ID}

# TikTok Ads API (optional - legacy)
TIKTOK_TOKEN=your-tiktok-access-token
TIKTOK_ACCESS_TOKEN=${TIKTOK_TOKEN}
TIKTOK_ADVERTISER_ID=your-tiktok-advertiser-id

# Shopify API (optional - legacy)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_PASSWORD=your-shopify-password
SHOPIFY_STORE=your-shopify-store-name
