# ETL Cron Schedule
# Runs daily at 01:10 America/Toronto time
# 
# To install:
#   crontab -e
#   Add this line:
#   10 1 * * * cd /path/to/workspace && TZ=America/Toronto /usr/bin/node scripts/etl/pull_ads_meta.ts --cron
#   15 1 * * * cd /path/to/workspace && TZ=America/Toronto /usr/bin/node scripts/etl/pull_ads_tiktok.ts --cron
#   20 1 * * * cd /path/to/workspace && TZ=America/Toronto /usr/bin/node scripts/etl/pull_shopify_orders.ts --cron
#   25 1 * * * cd /path/to/workspace && TZ=America/Toronto /usr/bin/node scripts/etl/compute_metrics.ts --cron

# Note: This file is a reference. Actual cron jobs should be set up via:
# 1. GitHub Actions (recommended) - see /infra/gh-actions/nightly-etl.yml
# 2. System cron (alternative) - use the commands above
# 3. Supabase Edge Functions (alternative) - schedule via Supabase dashboard

# Timezone: America/Toronto
# Schedule: Daily at 01:10 local time
