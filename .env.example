# What's For Dinner - Environment Variables Template
# Copy this file to .env.local for local development or configure in your deployment platform

# ===== Core Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ===== Database =====
DATABASE_URL=postgresql://postgres:${SUPABASE_SERVICE_ROLE_KEY}@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
PRISMA_CLIENT_ENGINE_TYPE=wasm

# ===== App Configuration =====
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_ENV=development
LOG_LEVEL=info
NODE_ENV=development

# ===== OAuth Providers =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Storage =====
NEXT_PUBLIC_UPLOAD_BUCKET=public
SIGNING_SECRET=

# ===== Redis Configuration =====
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5

# ===== Webhook Secrets =====
WEBHOOK_SECRET_PARTNER=
WEBHOOK_SECRET_PAYMENTS=

# ===== OpenAI Configuration =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ===== Email Configuration =====
RESEND_API_KEY=
SENDER_EMAIL=no-reply@whatsfordinner.app
