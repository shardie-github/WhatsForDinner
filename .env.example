# ===== Search & Recommendations =====
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=
NEXT_PUBLIC_MEILI_HOST=
NEXT_PUBLIC_MEILI_KEY=

# ===== Security & Bot Protection =====
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ===== Chat & Support =====
NEXT_PUBLIC_TIDIO_KEY=
NEXT_PUBLIC_CRISP_ID=

# ===== Commerce & Payments =====
NEXT_PUBLIC_LEMONSQUEEZY_STORE=
LEMONSQUEEZY_API_KEY=

# ===== Trust & Reviews =====
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_ID=

# ===== Monetization Configuration =====
AFFILIATE_ENABLED=true
AFFILIATE_COMMISSION_RATE=10
AFFILIATE_MIN_PAYOUT=50
API_MONETIZATION_ENABLED=true
DATA_INSIGHTS_ENABLED=true
MARKETPLACE_ENABLED=true
MARKETPLACE_COMMISSION_RATE=10
AUTOMATED_UPSELLS_ENABLED=true
CRON_SECRET=

# ===== Application Configuration =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ===== Feature Flags & Experiments =====
EXPERIMENT_CONFIG_PATH=./experiments
EXPERIMENTS_KILL_SWITCH=false

# ===== RegTech Layer Configuration =====
PRIVACY_OFFICER_EMAIL=privacy@whatsfordinner.app
DSAR_VERIFICATION_JWT_SECRET=
ARTIFACTS_BUCKET_URL=/tmp/artifacts
ARTIFACTS_BUCKET_SIGNING_KEY=
EVIDENCE_IMMUTABLE_BUCKET_URL=/tmp/evidence
MAGIC_LINK_BASE_URL=http://localhost:3000/privacy/verify
CCM_ALERT_WEBHOOK=
LEGAL_HOLD_DEFAULT=false
DSAR_DEADLINE_DAYS=30
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRY=8h

# ===== Observability & Monitoring =====
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
PROMETHEUS_PORT=9464
ENABLE_PROMETHEUS=true
ENABLE_OTLP=true

# ===== Alerting =====
PAGERDUTY_API_KEY=
SLACK_ALERT_WEBHOOK=

# ===== Backup & Disaster Recovery =====
BACKUP_BUCKET_URL=/tmp/backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# ===== Failover & DNS =====
FAILOVER_DNS_ZONE_ID=

# ===== Chaos Engineering =====
CHAOS_ENABLED=false

# ===== Performance Testing =====
PERF_THRESHOLD_PCT=10
BASE_URL=http://localhost:3000

# ===== Self-Healing =====
MAX_QUERY_DURATION_MS=30000
ENABLE_AUTO_ROLLBACK=false
QUEUE_NAME=default

# ===== System Configuration =====
SYSTEM_USER_ID=system

# ===== Encryption =====
ENCRYPTION_KEY=

# ===== Google Fit Integration =====
NEXT_PUBLIC_GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# ===== Notes =====
# 1. Never commit .env.local to version control
# 2. Use different keys for development, staging, and production
# 3. Rotate secrets regularly
# 4. Use secret management services in production
# 5. For production, configure these in your deployment platform's environment variables UI
