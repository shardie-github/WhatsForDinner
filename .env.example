# What's For Dinner - Environment Variables Template
# Copy this file to .env.local for local development or configure in your deployment platform

# ===== Core Supabase =====
# Replace <your-project-ref> with your actual Supabase project reference
# The project ref can be found in your Supabase dashboard URL or extracted from your Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# SUPABASE_PROJECT_REF is optional - it will be automatically extracted from NEXT_PUBLIC_SUPABASE_URL if not set
# SUPABASE_PROJECT_REF=<your-project-ref>

# ===== Database =====
# Replace <your-project-ref> with your actual Supabase project reference
DATABASE_URL=postgresql://postgres:${SUPABASE_SERVICE_ROLE_KEY}@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# ===== Prisma =====
PRISMA_CLIENT_ENGINE_TYPE=wasm

# ===== App =====
NEXTAUTH_URL=
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_ENV=production
LOG_LEVEL=info

# ===== OAuth (enable what code references) =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Storage/signing (if referenced) =====
NEXT_PUBLIC_UPLOAD_BUCKET=public
SIGNING_SECRET=

# =============================================================================
# Redis Configuration (Required for caching and queues)
# =============================================================================
REDIS_URL=redis://localhost:6379
# Or for Upstash: redis://default:<password>@<host>:<port>

# =============================================================================
# Queue Configuration
# =============================================================================
QUEUE_CONCURRENCY=5

# =============================================================================
# Webhook Secrets (Required for webhook verification)
# =============================================================================
WEBHOOK_SECRET_PARTNER=your-partner-webhook-secret-here
WEBHOOK_SECRET_PAYMENTS=your-payments-webhook-secret-here

# =============================================================================
# OpenAI Configuration (Required for AI meal generation)
# =============================================================================
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# =============================================================================
# Email Configuration (Required for weekly digests)
# =============================================================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDER_EMAIL=no-reply@nomad.app

# =============================================================================
# CRM Provider (Growth Systems)
# =============================================================================
# Options: sendgrid, klaviyo, noop
CRM_PROVIDER=sendgrid

# SendGrid (if using SendGrid)
SENDGRID_FROM=no-reply@nomad.app
SENDGRID_FROM_NAME=Nomad

# Klaviyo (if using Klaviyo)
KLAVIYO_API_KEY=your-klaviyo-api-key
KLAVIYO_LIST_ID=your-list-id

# Deep Links for Referrals
BRANCH_OR_DEEPLINK_BASE=https://nomad.app/r

# Experiments Guardrail Kill Switch
EXPERIMENTS_KILL_SWITCH=false

# =============================================================================
# Stripe Configuration (Required for Payments)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Webhook secret for Stripe webhooks
# Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# =============================================================================
# Partner Revenue Network Configuration
# =============================================================================
# Stripe Connect platform fee percentage (0.10 = 10%)
CONNECT_PLATFORM_FEE_PCT=0.10

# Default affiliate revenue share percentage (0.10 = 10%)
AFFILIATE_DEFAULT_SHARE_PCT=0.10

# Link signing secret for HMAC verification (generate random 32+ char string)
LINK_SIGNING_SECRET=your-link-signing-secret-min-32-chars

# Exchange rate API key (optional, uses fallback rates if not provided)
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# GeoIP license key (optional, for country-level geo detection)
GEOIP_LICENSE_KEY=your-geoip-license-key

# Partner conversion webhook HMAC secret
PARTNER_CONVERSION_HMAC_SECRET=your-partner-conversion-hmac-secret

# Default attribution window in days (1-30)
ATTRIBUTION_WINDOW_DAYS=7

# =============================================================================
# Observability - OpenTelemetry
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector-endpoint
OTEL_SERVICE_NAME=nomad-backend

# =============================================================================
# Backend Mode (next or fastify)
# =============================================================================
BACKEND_MODE=next

# =============================================================================
# Analytics & Monitoring (Optional but Recommended)
# =============================================================================
# Google Analytics (if using)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# PostHog Analytics (Alternative to Google Analytics)
NEXT_PUBLIC_POSTHOG_KEY=ph_your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Vercel Analytics (free on Vercel, no config needed)
# Automatically enabled when deployed on Vercel

# Microsoft Clarity (Session replay and heatmaps)
NEXT_PUBLIC_CLARITY_ID=your-clarity-id-here

# Plausible Analytics (Alternative privacy-focused analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Sentry Error Tracking (if using)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# =============================================================================
# Media & Upload Services
# =============================================================================
# Cloudinary (Media optimization and CDN)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Uploadcare (Alternative upload service)
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=your-uploadcare-public-key

# =============================================================================
# Realtime & Live Features
# =============================================================================
# Pusher Channels (Realtime messaging and FOMO features)
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=your-pusher-cluster

# Ably Realtime (Alternative realtime service)
NEXT_PUBLIC_ABLY_KEY=your-ably-key

# =============================================================================
# Gamification & Community Features
# =============================================================================
# Feature flags are managed in apps/web/src/config/flags.gamify.json
# Ensure Supabase keys are configured above for journal, posts, reactions, badges

# =============================================================================
# Search & Recommendations
# =============================================================================
# Algolia (Search and recommendations)
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-algolia-search-key
ALGOLIA_ADMIN_KEY=your-algolia-admin-key

# Meilisearch (Self-hosted search alternative)
NEXT_PUBLIC_MEILI_HOST=https://your-meilisearch-host
NEXT_PUBLIC_MEILI_KEY=your-meilisearch-key

# =============================================================================
# Security & Bot Protection
# =============================================================================
# hCaptcha (Privacy-forward bot protection)
NEXT_PUBLIC_HCAPTCHA_SITEKEY=your-hcaptcha-sitekey
HCAPTCHA_SECRET=your-hcaptcha-secret

# Google reCAPTCHA v3 (Alternative bot protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# =============================================================================
# Chat & Support
# =============================================================================
# Tidio (Live chat and support)
NEXT_PUBLIC_TIDIO_KEY=your-tidio-key

# Crisp (Alternative chat and support)
NEXT_PUBLIC_CRISP_ID=your-crisp-id

# =============================================================================
# Commerce & Payments
# =============================================================================
# LemonSqueezy (Hosted checkout and payments)
NEXT_PUBLIC_LEMONSQUEEZY_STORE=your-store-id
LEMONSQUEEZY_API_KEY=your-api-key

# =============================================================================
# Trust & Reviews
# =============================================================================
# Trustpilot (Reviews and trust badges)
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_ID=your-business-id

# =============================================================================
# Application Configuration
# =============================================================================
# Application environment
NODE_ENV=production
# or: development, staging, production

# Application URL
NEXT_PUBLIC_APP_URL=https://whats-for-dinner.vercel.app

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://whats-for-dinner.vercel.app

# Logging
LOG_LEVEL=info

# =============================================================================
# Feature Flags & Experiments
# =============================================================================
# Experiment configuration file path (optional)
EXPERIMENT_CONFIG_PATH=./experiments

# =============================================================================
# RegTech Layer Configuration
# =============================================================================
# Privacy Officer email (for DSAR notifications)
PRIVACY_OFFICER_EMAIL=privacy@nomad.app

# DSAR verification JWT secret (separate from main JWT secret for isolation)
DSAR_VERIFICATION_JWT_SECRET=your-dsar-jwt-secret-min-32-chars

# Artifacts storage bucket URL (local path or S3/GCS URL)
ARTIFACTS_BUCKET_URL=/tmp/artifacts
# Production: s3://nomad-artifacts or gs://nomad-artifacts

# Artifacts bucket signing key (for signed URLs)
ARTIFACTS_BUCKET_SIGNING_KEY=your-artifact-signing-key-min-32-chars

# Evidence storage bucket URL (immutable, versioned)
EVIDENCE_IMMUTABLE_BUCKET_URL=/tmp/evidence
# Production: s3://nomad-evidence or gs://nomad-evidence

# Magic link base URL for DSAR verification
MAGIC_LINK_BASE_URL=https://nomad.app/privacy/verify
# Local: http://localhost:3000/privacy/verify

# Controls monitoring alert webhook (optional)
CCM_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Legal hold default (set to true if all data should be held by default)
LEGAL_HOLD_DEFAULT=false

# DSAR deadline days (default: 30 for GDPR)
DSAR_DEADLINE_DAYS=30

# Admin JWT secret (for admin panel authentication)
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRY=8h

# =============================================================================
# Observability & Monitoring
# =============================================================================
# Prometheus metrics endpoint URL
PROMETHEUS_URL=http://localhost:9090

# Grafana dashboard URL
GRAFANA_URL=http://localhost:3001

# Loki logs endpoint URL
LOKI_URL=http://localhost:3100

# Tempo traces endpoint URL
TEMPO_URL=http://localhost:3200

# OpenTelemetry OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# Alerting
# =============================================================================
# PagerDuty API key for critical alerts
PAGERDUTY_API_KEY=your-pagerduty-api-key

# Slack webhook URL for alerts
SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# Backup & Disaster Recovery
# =============================================================================
# Backup storage bucket URL (S3/GCS path or local path)
BACKUP_BUCKET_URL=s3://nomad-backups
# Or: gs://nomad-backups
# Or: /tmp/backups (local development)

# Backup encryption key (AES-256-GCM)
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-min-32-chars

# Backup retention days
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Failover & DNS
# =============================================================================
# Cloudflare DNS zone ID for failover
FAILOVER_DNS_ZONE_ID=your-cloudflare-zone-id

# =============================================================================
# Chaos Engineering
# =============================================================================
# Enable chaos engineering tests
CHAOS_ENABLED=false

# =============================================================================
# Performance Testing
# =============================================================================
# Performance regression threshold (percentage)
PERF_THRESHOLD_PCT=10

# Base URL for performance tests
BASE_URL=http://localhost:3000

# =============================================================================
# Self-Healing
# =============================================================================
# Maximum query duration before termination (milliseconds)
MAX_QUERY_DURATION_MS=30000

# Enable automatic migration rollback on failure
ENABLE_AUTO_ROLLBACK=false

# Queue name for BullMQ
QUEUE_NAME=default

# =============================================================================
# System Configuration
# =============================================================================
# System user ID for automated actions
SYSTEM_USER_ID=system

# =============================================================================
# Observability Stack URLs
# =============================================================================
# Prometheus metrics scraping endpoint
PROMETHEUS_PORT=9464

# Enable Prometheus exporter
ENABLE_PROMETHEUS=true

# Enable OTLP exporter
ENABLE_OTLP=true

# =============================================================================
# Container Signing (Cosign)
# =============================================================================
# Cosign private key for container image signing (base64 encoded)
COSIGN_PRIVATE_KEY=

# =============================================================================
# Dependency Tracking
# =============================================================================
# Dependency-Track API key (for SBOM upload)
DEPENDENCY_TRACK_API_KEY=
DEPENDENCY_TRACK_URL=

# =============================================================================
# Notes
# =============================================================================
# 1. Never commit .env.local to version control
# 2. Use different keys for development, staging, and production
# 3. Rotate secrets regularly
# 4. Use secret management services in production (Vercel Secrets, AWS Secrets Manager, etc.)
# 5. For production, configure these in your deployment platform's environment variables UI
#
# Vercel: https://vercel.com/docs/projects/environment-variables
# Supabase: Dashboard > Settings > API
# Stripe: https://dashboard.stripe.com/apikeys
# OpenAI: https://platform.openai.com/api-keys
