AFFILIATE_DEFAULT_SHARE_PCT=0.10
LINK_SIGNING_SECRET=
EXCHANGE_RATE_API_KEY=
GEOIP_LICENSE_KEY=
PARTNER_CONVERSION_HMAC_SECRET=
