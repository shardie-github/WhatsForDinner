# What's For Dinner - Environment Variables Template
# Copy this file to .env.local for local development or configure in your deployment platform

# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, NEVER expose to client)
# Only used for admin operations and server-side API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection URL (for migrations and audits)
# Format: postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# JWT secret for token verification (should match Supabase JWT secret)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Project reference (used by Supabase CLI)
SUPABASE_PROJECT_REF=your-project-ref

# Alternative: DATABASE_URL (used by Prisma and other tools)
DATABASE_URL=${SUPABASE_DB_URL}

# Prisma Client Engine Type (WASM for edge/runtime compatibility)
PRISMA_CLIENT_ENGINE_TYPE=wasm

# =============================================================================
# Redis Configuration (Required for caching and queues)
# =============================================================================
REDIS_URL=redis://localhost:6379
# Or for Upstash: redis://default:<password>@<host>:<port>

# =============================================================================
# Queue Configuration
# =============================================================================
QUEUE_CONCURRENCY=5

# =============================================================================
# Webhook Secrets (Required for webhook verification)
# =============================================================================
WEBHOOK_SECRET_PARTNER=your-partner-webhook-secret-here
WEBHOOK_SECRET_PAYMENTS=your-payments-webhook-secret-here

# =============================================================================
# OpenAI Configuration (Required for AI meal generation)
# =============================================================================
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# =============================================================================
# Email Configuration (Required for weekly digests)
# =============================================================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDER_EMAIL=no-reply@nomad.app

# =============================================================================
# CRM Provider (Growth Systems)
# =============================================================================
# Options: sendgrid, klaviyo, noop
CRM_PROVIDER=sendgrid

# SendGrid (if using SendGrid)
SENDGRID_FROM=no-reply@nomad.app
SENDGRID_FROM_NAME=Nomad

# Klaviyo (if using Klaviyo)
KLAVIYO_API_KEY=your-klaviyo-api-key
KLAVIYO_LIST_ID=your-list-id

# Deep Links for Referrals
BRANCH_OR_DEEPLINK_BASE=https://nomad.app/r

# Experiments Guardrail Kill Switch
EXPERIMENTS_KILL_SWITCH=false

# =============================================================================
# Stripe Configuration (Required for Payments)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Webhook secret for Stripe webhooks
# Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# =============================================================================
# Partner Revenue Network Configuration
# =============================================================================
# Stripe Connect platform fee percentage (0.10 = 10%)
CONNECT_PLATFORM_FEE_PCT=0.10

# Default affiliate revenue share percentage (0.10 = 10%)
AFFILIATE_DEFAULT_SHARE_PCT=0.10

# Link signing secret for HMAC verification (generate random 32+ char string)
LINK_SIGNING_SECRET=your-link-signing-secret-min-32-chars

# Exchange rate API key (optional, uses fallback rates if not provided)
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# GeoIP license key (optional, for country-level geo detection)
GEOIP_LICENSE_KEY=your-geoip-license-key

# Partner conversion webhook HMAC secret
PARTNER_CONVERSION_HMAC_SECRET=your-partner-conversion-hmac-secret

# Default attribution window in days (1-30)
ATTRIBUTION_WINDOW_DAYS=7

# =============================================================================
# Observability - OpenTelemetry
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector-endpoint
OTEL_SERVICE_NAME=nomad-backend

# =============================================================================
# Backend Mode (next or fastify)
# =============================================================================
BACKEND_MODE=next

# =============================================================================
# Analytics & Monitoring (Optional but Recommended)
# =============================================================================
# Google Analytics (if using)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# PostHog Analytics (Alternative to Google Analytics)
NEXT_PUBLIC_POSTHOG_KEY=ph_your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking (if using)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# =============================================================================
# Application Configuration
# =============================================================================
# Application environment
NODE_ENV=production
# or: development, staging, production

# Application URL
NEXT_PUBLIC_APP_URL=https://whats-for-dinner.vercel.app

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://whats-for-dinner.vercel.app

# Logging
LOG_LEVEL=info

# =============================================================================
# Feature Flags & Experiments
# =============================================================================
# Experiment configuration file path (optional)
EXPERIMENT_CONFIG_PATH=./experiments

# =============================================================================
# Notes
# =============================================================================
# 1. Never commit .env.local to version control
# 2. Use different keys for development, staging, and production
# 3. Rotate secrets regularly
# 4. Use secret management services in production (Vercel Secrets, AWS Secrets Manager, etc.)
# 5. For production, configure these in your deployment platform's environment variables UI
#
# Vercel: https://vercel.com/docs/projects/environment-variables
# Supabase: Dashboard > Settings > API
# Stripe: https://dashboard.stripe.com/apikeys
# OpenAI: https://platform.openai.com/api-keys
