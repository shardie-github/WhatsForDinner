CRM_PROVIDER=sendgrid

# ===== Stripe Configuration =====
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Partner Revenue Network =====
