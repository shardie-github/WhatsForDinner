# ===== Observability =====
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=whats-for-dinner-backend

# ===== Backend Mode =====
BACKEND_MODE=next

# ===== Analytics & Monitoring =====
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
