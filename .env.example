# =============================================================================
# Environment Variables Template
# Copy this file to .env.local for local development
# Never commit .env.local to version control
# =============================================================================

# =============================================================================
# Core Supabase Configuration (Source of Truth)
# =============================================================================
# Get these values from your Supabase Dashboard > Settings > API
# Supabase Dashboard: https://app.supabase.com/project/<your-project-ref>/settings/api

# Public (Client-side) - Exposed to browser
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side (Private) - Never expose to client
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# =============================================================================
# Database Configuration
# =============================================================================
# Connection string for Prisma and direct database access
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# =============================================================================
# Additional Configuration (Optional)
# =============================================================================
# Prisma Client Engine Type (WASM for mobile compatibility)
PRISMA_CLIENT_ENGINE_TYPE=wasm

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Application URL (for callbacks and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Notes
# =============================================================================
# 1. Supabase is the source of truth for:
#    - DATABASE_URL
#    - SUPABASE_URL
#    - SUPABASE_ANON_KEY
#    - SUPABASE_SERVICE_ROLE_KEY
#    - SUPABASE_JWT_SECRET
#
# 2. For production:
#    - Configure in Vercel Dashboard > Settings > Environment Variables
#    - Add to GitHub Actions Secrets for CI/CD
#
# 3. For local development:
#    - Copy this file to .env.local
#    - Fill in values from Supabase Dashboard
#    - Or use: vercel env pull .env.local
#
# 4. Required variables for basic functionality:
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - SUPABASE_SERVICE_ROLE_KEY (for server-side operations)
#    - DATABASE_URL (for Prisma migrations)
