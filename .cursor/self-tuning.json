{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Self-tuning configuration for Cursor Background Agent",
  "thresholds": {
    "typeCoverage": {
      "target": 95,
      "min": 90,
      "max": 98,
      "adjustmentStep": 1,
      "lastRun": null,
      "lastCoverage": null
    },
    "testCoverage": {
      "target": 80,
      "min": 70,
      "max": 90
    },
    "bundleSize": {
      "target": 500,
      "max": 1000,
      "unit": "KB"
    },
    "performance": {
      "p95Latency": {
        "target": 200,
        "max": 500,
        "unit": "ms"
      },
      "lcp": {
        "target": 2500,
        "max": 4000,
        "unit": "ms"
      }
    }
  },
  "exclusions": {
    "typeCoverage": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "apps/web/src/app/admin/**",
      "apps/web/src/app/developers/**"
    ],
    "linting": [
      "**/generated/**",
      "**/migrations/**"
    ],
    "performance": [
      "**/tests/**",
      "**/__tests__/**"
    ]
  },
  "autoAdjust": {
    "enabled": true,
    "typeCoverage": {
      "enabled": true,
      "basedOnLastRuns": 2,
      "minRunsForAdjustment": 2
    }
  },
  "history": {
    "typeCoverage": [],
    "lastUpdated": null
  }
}
