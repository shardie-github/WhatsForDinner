{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Self-tuning configuration for Cursor agent",
  "thresholds": {
    "typeCoverage": {
      "target": 95,
      "min": 90,
      "max": 100,
      "adjustmentStep": 1,
      "lastRun": null,
      "lastCoverage": null,
      "trend": "stable"
    },
    "testCoverage": {
      "target": 80,
      "min": 70,
      "max": 95,
      "adjustmentStep": 1
    },
    "bundleSize": {
      "target": 500,
      "max": 600,
      "unit": "KB"
    },
    "performance": {
      "lcp": {
        "target": 2.5,
        "max": 4.0,
        "unit": "seconds"
      },
      "fid": {
        "target": 100,
        "max": 300,
        "unit": "milliseconds"
      },
      "cls": {
        "target": 0.1,
        "max": 0.25,
        "unit": "score"
      }
    }
  },
  "exclusions": {
    "typeCoverage": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/__tests__/**",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**"
    ],
    "files": [
      "**/generated/**",
      "**/vendor/**",
      "**/legacy/**"
    ]
  },
  "autoAdjust": {
    "enabled": true,
    "typeCoverage": {
      "enabled": true,
      "runsToConsider": 2,
      "adjustmentThreshold": 0.5
    }
  },
  "history": {
    "typeCoverage": [],
    "lastUpdated": null
  },
  "rules": {
    "neverDeletePublicAPIs": true,
    "preserveI18nPlaceholders": true,
    "noMajorDepSwapsWithoutTests": true,
    "systemsChangesDocsFirst": true
  }
}
