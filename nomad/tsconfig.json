{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@nomad/config": ["./packages/config/src"],
      "@nomad/data": ["./packages/data/src"],
      "@nomad/ui": ["./packages/ui/src"],
      "@nomad/adapters": ["./packages/adapters/src"],
      "@nomad/analytics": ["./packages/analytics/src"],
      "@nomad/i18n": ["./packages/i18n/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/build", "**/.next"]
}
